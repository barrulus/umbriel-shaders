local check = require("./check")
local Catalogue = require("../lib/catalogue")
local Config = require("../lib/config")

check.eq(Config.value('a"b\\c\n'), '"a\\"b\\\\c\\n"', "string escaping")
check.eq(Config.value("\1"), '"\\u0001"', "control characters")
check.eq(Config.value(true), "true", "boolean")
check.eq(Config.value(1050), "1050", "integer")
check.eq(Config.value(0.2), "0.2", "float")

local HEADER = "# Generated by the Umbriel Shaders Noctalia plugin. Changes are overwritten."
local empty = { slots = {}, apps = {}, timing = {}, imports = {} }
check.eq(Config.render(empty), HEADER .. "\n", "empty selection renders only the header")

-- Real resolved entries from the fixture catalogue (revision abc123).
local cat = Catalogue.index(require("./fixture"))
local glow = Catalogue.resolve(cat, cat.byId["border/glow"], "effects.border", "/s")
local fade = Catalogue.resolve(cat, cat.byId["animation/fade"], "animation.windows_in", "/s")

-- A hand-made entry for `id`, with `fields` replacing the defaults.
local function entry(id, preset, fields)
  local e = { id = id, name = id, preset = preset, deps = {}, include = {}, settings = {} }
  for key, value in pairs(fields) do
    e[key] = value
  end
  return e
end
-- Companions are not listable in the catalogue, so this one is made by hand.
local overlay = entry("window/glow-overlay", "glow-overlay", {
  include = { "/s/abc123/window/glow-overlay/effect.toml" },
  settings = { ["effects.window"] = "glow-overlay" },
})
local selection = {
  slots = {
    ["effects.border"] = glow,
    ["effects.window"] = overlay,
    ["animation.windows_in"] = fade,
  },
  apps = {
    { app_id = "org.gnome.Nautilus", slot = "effects.border", entry = glow },
    { app_id = "mpv", slot = "effects.window" },
  },
  timing = {
    ["animation.windows_in"] = { duration_ms = 450, curve = "linear" },
    ["animation.workspaces"] = { duration_ms = 1 },
  },
  imports = {},
}
local expected = table.concat({
  HEADER,
  "",
  "[include]",
  "files = [",
  '  "/s/abc123/animation/fade/effect.toml",',
  '  "/s/abc123/border/glow/effect.toml",',
  "]",
  "",
  "[animation]",
  "enabled = true",
  "",
  "[animation.windows_in]",
  'curve = "linear"',
  "duration_ms = 450",
  'effect = "fade"',
  "enabled = true",
  "",
  "[effects]",
  'border = "glow"',
  'window = "glow-overlay"',
  "",
  "[[window_rule]]",
  'match.app_id = "^org\\\\.gnome\\\\.Nautilus$"',
  'border_effect = "glow"',
  "",
  "[[window_rule]]",
  'match.app_id = "^mpv$"',
  'window_effect = "off"',
  "",
}, "\n")
check.eq(
  Config.render(selection),
  expected,
  "companion include skipped, includes sorted, timing overrides applied, unset-slot timing ignored"
)
-- One effect id at two catalogue revisions includes only one revision.
local function atRevision(revision)
  return entry("border/glow", "glow", {
    revision = revision,
    include = { "/s/" .. revision .. "/border/glow/effect.toml" },
    settings = { ["effects.border"] = "glow" },
  })
end
local twoRevisions = {
  slots = { ["effects.border"] = atRevision("r1") },
  apps = { { app_id = "mpv", slot = "effects.border", entry = atRevision("r2") } },
  timing = {},
  imports = {},
}
local rendered = Config.render(twoRevisions)
check.eq(select(2, rendered:gsub("effect%.toml", "")), 1, "one include path per effect id")
check.truthy(rendered:find("/s/r2/", 1, true), "the greatest revision is kept")
check.done("config render")
